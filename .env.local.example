# ========================================
# EVENT LISTENER CONFIGURATION (Optional)
# ========================================
EVENT_LISTENER_POLL_INTERVAL=5000  # Milliseconds between polling
EVENT_LISTENER_BATCH_SIZE=100      # Number of events to process at once

# ========================================
# PRODUCTION NETWORKS (Uncomment when ready)
# ========================================

# Polygon Mainnet (Production)
# NEXT_PUBLIC_RPC_URL=https://polygon-rpc.com
# NEXT_PUBLIC_CHAIN_ID=137

# Ethereum Mainnet (Expensive - Not Recommended)
# NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_CHAIN_ID=1

# ========================================
# NOTES
# ========================================
# 1. Copy this file to .env.local and fill in your values
# 2. Get free Mumbai MATIC from: https://faucet.polygon.technology/
# 3. Deploy contract: npx hardhat run scripts/deploy.js --network mumbai
# 4. Update NEXT_PUBLIC_CONTRACT_ADDRESS with deployed address
# 5. Never commit .env.local to git!

